# Google Gemini / ADK configuration
GOOGLE_API_KEY=your_google_api_key_here
AEACUS_MODEL=gemini-3.8-flash

# OpenAI Embeddings configuration (for EU AI Act retrieval)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone Vector Database configuration (dedicated AeacusAI namespace)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=maven-rag
PINECONE_NAMESPACE=aeacusai-dev

# Langfuse (optional local tracing)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
AEACUS_LANGFUSE_TRACING=0

# Durable project memory (external Postgres). Leave unset to keep memory unavailable.
# Use a resolved URL with TLS (sslmode=require). Do not paste ${{ }} templates.
AEACUS_MEMORY_DATABASE_URL=
AEACUS_MEMORY_SCHEMA=aeacus_memory
AEACUS_MEMORY_TTL_DAYS=180
